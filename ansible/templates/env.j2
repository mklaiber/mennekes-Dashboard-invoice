# =============================================================================
#  ACHTUNG: Diese Datei wird von Ansible erzeugt (ansible/templates/env.j2).
#  Lokale Änderungen gehen beim nächsten Deployment verloren.
#  Erzeugt am {{ ansible_date_time.iso8601 }} von {{ lookup('env', 'USER') | default('ansible', true) }}
# =============================================================================

# ------------------------------- Laufzeit ------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TZ={{ app_timezone | default('Europe/Berlin') }}
LOG_LEVEL={{ log_level | default('info') }}
TRUST_PROXY={{ trust_proxy | default(false) | lower }}

OUTPUT_DIR=/app/data/reports
DATABASE_FILE=/app/data/wallbox.sqlite
SETTINGS_FILE=/app/data/settings.json

# ------------------------- WebUI-Authentifizierung ---------------------------
# Start-Administrator: wirkt nur, solange die Benutzertabelle leer ist.
AUTH_USER={{ auth_user | default('admin') }}
AUTH_PASSWORD={{ auth_password }}
AUTH_REALM={{ auth_realm | default('Mennekes Wallbox Abrechnung') }}
AUTH_MIN_PASSWORD_LENGTH={{ auth_min_password_length | default(12) }}
AUTH_MAX_FAILED_ATTEMPTS={{ auth_max_failed_attempts | default(8) }}
AUTH_LOCK_MINUTES={{ auth_lock_minutes | default(15) }}
AUTH_ALLOW_BASIC_API={{ auth_allow_basic_api | default(true) | lower }}

# --------------------------------- Sitzungen ---------------------------------
SESSION_TTL_HOURS={{ session_ttl_hours | default(12) }}
SESSION_REMEMBER_DAYS={{ session_remember_days | default(30) }}
SESSION_COOKIE_NAME={{ session_cookie_name | default('wb_session') }}
SESSION_COOKIE_SECURE={{ session_cookie_secure | default(false) | lower }}

# ----------------------------- Mennekes Wallbox ------------------------------
MENNEKES_BASE_URL={{ mennekes_base_url }}
MENNEKES_AUTH_MODE={{ mennekes_auth_mode | default('none') }}
MENNEKES_USERNAME={{ mennekes_username | default('') }}
MENNEKES_PASSWORD={{ mennekes_password | default('') }}
MENNEKES_TOKEN={{ mennekes_token | default('') }}
MENNEKES_API_KEY_HEADER={{ mennekes_api_key_header | default('X-API-Key') }}
MENNEKES_TIMEOUT_MS={{ mennekes_timeout_ms | default(8000) }}
MENNEKES_RETRIES={{ mennekes_retries | default(2) }}
MENNEKES_TLS_REJECT_UNAUTHORIZED={{ mennekes_tls_verify | default(true) | lower }}

MENNEKES_ENDPOINT_STATUS={{ mennekes_endpoint_status | default('/api/v1/status') }}
MENNEKES_ENDPOINT_SESSIONS={{ mennekes_endpoint_sessions | default('/api/v1/transactions') }}
MENNEKES_ENDPOINT_METER={{ mennekes_endpoint_meter | default('') }}
MENNEKES_SESSIONS_FROM_PARAM={{ mennekes_sessions_from_param | default('from') }}
MENNEKES_SESSIONS_TO_PARAM={{ mennekes_sessions_to_param | default('to') }}
MENNEKES_SESSIONS_LIMIT_PARAM={{ mennekes_sessions_limit_param | default('limit') }}
MENNEKES_SESSIONS_LIMIT={{ mennekes_sessions_limit | default(1000) }}

# ---------------------------------- SMTP -------------------------------------
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_SECURE={{ smtp_secure | default(false) | lower }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') }}
SMTP_TLS_REJECT_UNAUTHORIZED={{ smtp_tls_verify | default(true) | lower }}

# --------------------------------- E-Mail ------------------------------------
MAIL_FROM={{ mail_from }}
MAIL_TO={{ mail_to | join(',') if mail_to is sequence and mail_to is not string else mail_to }}
MAIL_CC={{ mail_cc | join(',') if mail_cc is defined and mail_cc is sequence and mail_cc is not string else (mail_cc | default('')) }}
MAIL_SUBJECT_PREFIX={{ mail_subject_prefix | default('Ladestrom-Abrechnung') }}

# -------------------------------- Abrechnung ---------------------------------
PRICE_PER_KWH={{ price_per_kwh | default(0.30) }}
CURRENCY={{ currency | default('EUR') }}
LOCALE={{ locale | default('de-DE') }}
COMPANY_NAME={{ company_name | default('') }}
EMPLOYEE_NAME={{ employee_name | default('') }}
VEHICLE_PLATE={{ vehicle_plate | default('') }}
LOGO_URL={{ logo_url | default('') }}

# ------------------------------ Automatisierung ------------------------------
CRON_ENABLED={{ cron_enabled | default(true) | lower }}
CRON_EXPRESSION={{ cron_expression | default('30 23 * * *') }}
CRON_RUN_POLICY={{ cron_run_policy | default('last-day-of-month') }}

# ------------------------------- Live-Dashboard ------------------------------
LIVE_POLL_INTERVAL_MS={{ live_poll_interval_ms | default(5000) }}
LIVE_HEARTBEAT_MS={{ live_heartbeat_ms | default(25000) }}

# --------------------------------- Puppeteer ---------------------------------
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_NO_SANDBOX=true
