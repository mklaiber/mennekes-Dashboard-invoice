# Kopieren nach `inventory.ini` und anpassen (inventory.ini ist gitignored).
#
#   ansible-playbook -i inventory.ini deploy.yml

[wallbox_billing]
homeserver ansible_host=192.168.1.10 ansible_user=admin

[wallbox_billing:vars]
ansible_python_interpreter=/usr/bin/python3
# Bei sudo mit Passwort zusätzlich `--ask-become-pass` verwenden.
