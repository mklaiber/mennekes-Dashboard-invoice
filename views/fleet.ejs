<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="md-content">

  <div class="md-row" style="margin-bottom:24px">
    <div>
      <h1 class="md-headline-m" style="margin:0">Fuhrpark</h1>
      <p class="md-body-m md-on-surface-variant" style="margin:4px 0 0">
        Firmen, Fahrzeuge und ihre Ladekarten. Ein Auto gehört privat oder zu genau einer Firma.
      </p>
    </div>
  </div>

  <div class="md-banner md-banner--info" style="margin-bottom:24px">
    <%- include('partials/icon', { name: 'shield' }) %>
    <span class="md-body-s">
      Die Zuordnung wird beim Eintreffen eines Ladevorgangs <strong>festgeschrieben</strong>.
      Wer eine Karte später einem anderen Fahrzeug zuordnet, ändert damit nur künftige
      Ladevorgänge – bereits abgerechnete bleiben unverändert.
    </span>
  </div>

  <!-- ============================================ Nicht zugeordnete Karten -->
  <% if (unassignedCards.length > 0) { %>
    <section class="md-card" style="margin-bottom:24px">
      <h2 class="md-title-m" style="margin:0 0 4px">
        <%- include('partials/icon', { name: 'warning', size: 18 }) %>
        Nicht zugeordnete Karten
      </h2>
      <p class="md-body-s md-on-surface-variant" style="margin:0 0 16px">
        Diese Karten sind in Ladevorgängen aufgetaucht, gehören aber zu keinem Fahrzeug.
        Solange das so bleibt, erscheinen ihre Ladevorgänge in keiner Firmenrechnung.
      </p>

      <div class="md-table-wrap">
        <table class="md-table">
          <caption class="sr-only">Karten ohne Fahrzeugzuordnung</caption>
          <thead>
            <tr>
              <th scope="col">Karte</th>
              <th scope="col">Ladevorgänge</th>
              <th scope="col">Energie</th>
              <th scope="col">Zuletzt</th>
              <th scope="col">Fahrzeug zuordnen</th>
            </tr>
          </thead>
          <tbody>
            <% unassignedCards.forEach(function (card) { %>
              <tr data-card="<%= card.rfid %>">
                <td>
                  <div class="md-mono"><%= card.rfid %></div>
                  <% if (!card.known) { %>
                    <span class="md-chip">unbekannt</span>
                  <% } %>
                </td>
                <td><%= card.sessionCount %></td>
                <td><%= card.energyKwh %> kWh</td>
                <td class="md-body-s"><%= new Date(card.lastSeenAt).toLocaleDateString('de-DE') %></td>
                <td>
                  <div class="md-row" style="gap:8px;align-items:center">
                    <select class="md-field__select" data-assign-vehicle style="min-width:220px" aria-label="Fahrzeug für <%= card.rfid %>">
                      <option value="">– wählen –</option>
                      <% vehicles.filter(function (v) { return v.active; }).forEach(function (vehicle) { %>
                        <option value="<%= vehicle.id %>"><%= vehicle.plate %><%= vehicle.employeeName ? ' · ' + vehicle.employeeName : '' %></option>
                      <% }); %>
                    </select>
                    <label class="md-body-s" style="display:flex;gap:4px;align-items:center;white-space:nowrap">
                      <input type="checkbox" data-assign-backfill checked>
                      <%= card.sessionCount %> rückwirkend
                    </label>
                    <button type="button" class="md-btn md-btn--tonal" data-assign-submit>Zuordnen</button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>

  <!-- ========================================================== Fahrzeuge -->
  <section class="md-card" style="margin-bottom:24px">
    <div class="md-row" style="margin-bottom:16px">
      <h2 class="md-title-m" style="margin:0">Fahrzeuge</h2>
      <span class="md-spacer"></span>
      <button type="button" class="md-btn md-btn--filled" data-new="vehicle">
        <%- include('partials/icon', { name: 'add', size: 18 }) %> Fahrzeug anlegen
      </button>
    </div>

    <div class="md-table-wrap">
      <table class="md-table">
        <caption class="sr-only">Fahrzeuge des Fuhrparks</caption>
        <thead>
          <tr>
            <th scope="col">Kennzeichen</th>
            <th scope="col">Firma</th>
            <th scope="col">Mitarbeiter</th>
            <th scope="col">Karten</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="sr-only">Aktionen</span></th>
          </tr>
        </thead>
        <tbody>
          <% if (vehicles.length === 0) { %>
            <tr><td colspan="6" class="md-body-s md-on-surface-variant">Noch keine Fahrzeuge angelegt.</td></tr>
          <% } %>
          <% vehicles.forEach(function (vehicle) { %>
            <tr data-vehicle='<%- JSON.stringify({ id: vehicle.id, plate: vehicle.plate, label: vehicle.label, companyId: vehicle.companyId, employeeName: vehicle.employeeName, notes: vehicle.notes, active: vehicle.active }) %>'>
              <td>
                <div class="md-label-l"><%= vehicle.plate %></div>
                <% if (vehicle.label) { %><div class="md-body-s md-on-surface-variant"><%= vehicle.label %></div><% } %>
              </td>
              <td>
                <% if (vehicle.isPrivate) { %>
                  <span class="md-chip">privat</span>
                <% } else { %>
                  <%= vehicle.companyName %>
                <% } %>
              </td>
              <td><%= vehicle.employeeName || '–' %></td>
              <td>
                <% if (vehicle.cards.length === 0) { %>
                  <span class="md-body-s md-on-surface-variant">keine</span>
                <% } %>
                <% vehicle.cards.forEach(function (card) { %>
                  <span class="md-chip md-mono" title="<%= card.rfidRaw %>"><%= card.rfid %></span>
                <% }); %>
              </td>
              <td>
                <span class="md-chip <%= vehicle.active ? 'md-chip--primary' : '' %>">
                  <%= vehicle.active ? 'aktiv' : 'stillgelegt' %>
                </span>
              </td>
              <td>
                <button type="button" class="md-btn md-btn--text" data-edit="vehicle">Bearbeiten</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============================================================= Firmen -->
  <section class="md-card" style="margin-bottom:24px">
    <div class="md-row" style="margin-bottom:16px">
      <div>
        <h2 class="md-title-m" style="margin:0">Firmen</h2>
        <p class="md-body-s md-on-surface-variant" style="margin:4px 0 0">
          Eigener Bericht heißt: eigene PDF an die eigene Kontaktadresse.
          Ohne eigenen Arbeitspreis gilt der aus den Einstellungen.
        </p>
      </div>
      <span class="md-spacer"></span>
      <button type="button" class="md-btn md-btn--filled" data-new="company">
        <%- include('partials/icon', { name: 'add', size: 18 }) %> Firma anlegen
      </button>
    </div>

    <div class="md-table-wrap">
      <table class="md-table">
        <caption class="sr-only">Firmen</caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Kontakt</th>
            <th scope="col">Arbeitspreis</th>
            <th scope="col">Eigener Bericht</th>
            <th scope="col"><span class="sr-only">Aktionen</span></th>
          </tr>
        </thead>
        <tbody>
          <% companies.forEach(function (company) { %>
            <tr data-company='<%- JSON.stringify({ id: company.id, name: company.name, kind: company.kind, address: company.address, contactEmail: company.contactEmail, pricePerKwh: company.pricePerKwh, ownReport: company.ownReport, active: company.active }) %>'>
              <td>
                <div class="md-label-l"><%= company.name %></div>
                <% if (!company.active) { %><span class="md-chip">stillgelegt</span><% } %>
                <%# Eine Firma ohne Auto ist hier ein Versehen: abgerechnet
                    wird je Fahrzeug, es gaebe also nichts zu berichten.
                    Erzwingen laesst es sich nicht - die Firma entsteht
                    zwangslaeufig vor ihrem ersten Auto. %>
                <% if (!vehicles.some(function (v) { return v.companyId === company.id; })) { %>
                  <span class="md-chip" title="Ohne Fahrzeug gibt es für diese Firma nichts abzurechnen">keine Fahrzeuge</span>
                <% } %>
              </td>
              <td class="md-body-s"><%= company.contactEmail || '–' %></td>
              <td>
                <% if (company.pricePerKwh === null) { %>
                  <span class="md-body-s md-on-surface-variant">global</span>
                <% } else { %>
                  <%# Bis zu drei Nachkommastellen: Arbeitspreise wie 0,328 sind
                      üblich, und auf 0,33 gerundet steht etwas anderes da, als
                      abgerechnet wird. %>
                  <%= company.pricePerKwh.toFixed(3).replace(/0$/, '').replace('.', ',') %> €/kWh
                <% } %>
              </td>
              <td>
                <span class="md-chip <%= company.ownReport ? 'md-chip--primary' : '' %>">
                  <%= company.ownReport ? 'ja' : 'nein' %>
                </span>
              </td>
              <td>
                <button type="button" class="md-btn md-btn--text" data-edit="company">Bearbeiten</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

</main>


<!-- ================================================================ Dialoge -->
<%
  // Auswahllisten einmal vorbereiten; die Dialoge teilen sie sich.
  var activeCompanies = companies.filter(function (c) { return c.active; });
%>

<dialog id="vehicle-dialog" class="md-dialog">
  <form class="md-dialog__panel" method="dialog">
    <h2 class="md-dialog__title" id="vehicle-dialog-title">Fahrzeug anlegen</h2>
    <div id="vehicle-dialog-error" class="md-banner md-banner--error hidden" style="margin-bottom:20px"></div>

    <div class="md-stack" style="gap:20px">
      <label class="md-field">
        <input class="md-field__input" type="text" id="vehicle-plate" placeholder=" " required>
        <span class="md-field__label">Kennzeichen</span>
      </label>

      <label class="md-field">
        <input class="md-field__input" type="text" id="vehicle-label" placeholder=" ">
        <span class="md-field__label">Bezeichnung (optional)</span>
      </label>

      <label class="md-field">
        <select id="vehicle-companyId" class="md-field__select">
          <option value="">– privat –</option>
          <% activeCompanies.forEach(function (company) { %>
            <option value="<%= company.id %>"><%= company.name %></option>
          <% }); %>
        </select>
        <span class="md-field__label">Firma</span>
        <span class="md-field__arrow"><%- include('partials/icon', { name: 'expand', size: 18 }) %></span>
      </label>

      <label class="md-field">
        <input class="md-field__input" type="text" id="vehicle-employeeName" placeholder=" ">
        <span class="md-field__label">Mitarbeiter (optional)</span>
        <span class="md-field__hint">Wer das Auto fährt – erscheint so auf der Abrechnung.</span>
      </label>

      <label class="md-field">
        <textarea class="md-field__textarea" id="vehicle-notes" placeholder=" "></textarea>
        <span class="md-field__label">Notiz (optional)</span>
      </label>

      <label class="md-switch" id="vehicle-active-row">
        <input type="checkbox" id="vehicle-active" checked>
        <span class="md-switch__track"><span class="md-switch__thumb"></span></span>
        <span class="md-body-m">Fahrzeug aktiv</span>
      </label>
    </div>

    <div class="md-dialog__actions">
      <button type="button" class="md-btn md-btn--text" data-dialog-cancel>Abbrechen</button>
      <button type="button" class="md-btn md-btn--filled" data-dialog-submit>Speichern</button>
    </div>
  </form>
</dialog>

<dialog id="company-dialog" class="md-dialog">
  <form class="md-dialog__panel" method="dialog">
    <h2 class="md-dialog__title" id="company-dialog-title">Firma anlegen</h2>
    <div id="company-dialog-error" class="md-banner md-banner--error hidden" style="margin-bottom:20px"></div>

    <div class="md-stack" style="gap:20px">
      <label class="md-field">
        <input class="md-field__input" type="text" id="company-name" placeholder=" " required>
        <span class="md-field__label">Name</span>
      </label>

      <label class="md-field">
        <textarea class="md-field__textarea" id="company-address" placeholder=" "></textarea>
        <span class="md-field__label">Rechnungsanschrift</span>
      </label>

      <label class="md-field">
        <input class="md-field__input" type="email" id="company-contactEmail" placeholder=" ">
        <span class="md-field__label">Kontaktadresse für Rechnungen</span>
        <span class="md-field__hint">Leer: der Bericht geht an den globalen Empfänger.</span>
      </label>

      <label class="md-field">
        <input class="md-field__input" type="text" id="company-pricePerKwh" placeholder=" "
               inputmode="decimal">
        <span class="md-field__label">Eigener Arbeitspreis (€/kWh)</span>
        <span class="md-field__hint">Leer lassen für den Preis aus den Einstellungen.</span>
      </label>

      <label class="md-switch">
        <input type="checkbox" id="company-ownReport" checked>
        <span class="md-switch__track"><span class="md-switch__thumb"></span></span>
        <span class="md-body-m">Eigener Monatsbericht per Mail</span>
      </label>

      <label class="md-switch" id="company-active-row">
        <input type="checkbox" id="company-active" checked>
        <span class="md-switch__track"><span class="md-switch__thumb"></span></span>
        <span class="md-body-m">Firma aktiv</span>
      </label>
    </div>

    <div class="md-dialog__actions">
      <button type="button" class="md-btn md-btn--text" data-dialog-cancel>Abbrechen</button>
      <button type="button" class="md-btn md-btn--filled" data-dialog-submit>Speichern</button>
    </div>
  </form>
</dialog>


<script src="/static/js/fleet.js" nonce="<%= cspNonce %>" defer></script>

<%- include('partials/foot') %>
