<!DOCTYPE html>
<html lang="de" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="grid h-full place-items-center bg-slate-950 px-6 text-slate-100">
  <main class="max-w-md text-center">
    <p class="text-6xl font-bold text-emerald-400"><%= status %></p>
    <h1 class="mt-3 text-xl font-semibold"><%= title %></h1>
    <p class="mt-2 text-sm text-slate-400"><%= message %></p>
    <a href="/" class="mt-6 inline-block rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
      Zurück zum Dashboard
    </a>
  </main>
</body>
</html>
