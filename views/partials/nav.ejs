<header class="md-topbar">
  <div class="md-topbar__brand">
    <span class="md-topbar__logo"><%- include('icon', { name: 'ev', size: 22 }) %></span>
    <span class="md-topbar__titles">
      <span class="md-topbar__title"><%= settings.wallbox.displayName %></span>
      <span class="md-topbar__subtitle">Ladestrom-Abrechnung</span>
    </span>
  </div>

  <span class="md-spacer"></span>

  <button type="button" class="md-icon-btn" data-theme-toggle>
    <span data-theme-icon="auto"><%- include('icon', { name: 'contrast' }) %></span>
    <span data-theme-icon="light" class="hidden"><%- include('icon', { name: 'light_mode' }) %></span>
    <span data-theme-icon="dark" class="hidden"><%- include('icon', { name: 'dark_mode' }) %></span>
  </button>

  <% if (currentUser) { %>
    <span class="md-chip md-chip--primary" title="Angemeldet als <%= currentUser.username %> (<%= currentUser.role === 'admin' ? 'Administrator' : 'Betrachter' %>)">
      <%- include('icon', { name: currentUser.role === 'admin' ? 'shield' : 'person', size: 16 }) %>
      <span><%= currentUser.displayName || currentUser.username %></span>
    </span>

    <form method="post" action="/logout" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="md-icon-btn" title="Abmelden" aria-label="Abmelden">
        <%- include('icon', { name: 'logout' }) %>
      </button>
    </form>
  <% } %>
</header>

<% if (currentUser) { %>
<nav class="md-tabs" aria-label="Hauptnavigation">
  <a href="/" class="md-tab" <%= active === 'dashboard' ? 'aria-current="page"' : '' %>>
    <%- include('icon', { name: 'dashboard', size: 18 }) %> Dashboard
  </a>
  <% if (currentUser.role === 'admin') { %>
    <a href="/einstellungen" class="md-tab" <%= active === 'settings' ? 'aria-current="page"' : '' %>>
      <%- include('icon', { name: 'settings', size: 18 }) %> Einstellungen
    </a>
    <a href="/fuhrpark" class="md-tab" <%= active === 'fleet' ? 'aria-current="page"' : '' %>>
      <%- include('icon', { name: 'ev', size: 18 }) %> Fuhrpark
    </a>
    <a href="/benutzer" class="md-tab" <%= active === 'users' ? 'aria-current="page"' : '' %>>
      <%- include('icon', { name: 'people', size: 18 }) %> Benutzer
    </a>
  <% } %>
  <a href="/passwort" class="md-tab" <%= active === 'account' ? 'aria-current="page"' : '' %>>
    <%- include('icon', { name: 'key', size: 18 }) %> Passwort
  </a>
</nav>
<% } %>
