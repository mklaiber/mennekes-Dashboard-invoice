<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="md-content">

  <div style="margin-bottom:24px">
    <h1 class="md-headline-m" style="margin:0">Einstellungen</h1>
    <p class="md-body-m md-on-surface-variant" style="margin:4px 0 0">
      Nicht sensible Konfiguration. Zugangsdaten (SMTP-Passwort, Wallbox-Token) kommen
      ausschließlich aus der <span class="md-mono">.env</span> und sind hier bewusst nicht änderbar.
    </p>
  </div>

  <form id="settings-form" class="md-stack" style="gap:24px">

    <!-- ===================== Wallbox ===================== -->
    <section class="md-card">
      <div class="md-card__header">
        <div>
          <h2 class="md-card__title"><%- include('partials/icon', { name: 'ev', size: 18 }) %> Wallbox</h2>
          <p class="md-card__support">
            Nur der Anzeigename. Die Ladedaten liefert der Connector aus dem Heimnetz –
            eine Adresse ist hier nicht einzustellen.
          </p>
        </div>
      </div>

      <div class="md-grid md-cols-2" style="margin-top:20px">
        <label class="md-field">
          <input class="md-field__input" type="text" id="wallbox-displayName" placeholder=" "
                 value="<%= settings.wallbox.displayName %>">
          <span class="md-field__label">Anzeigename</span>
        </label>
      </div>
    </section>

    <!-- ===================== Abrechnung ===================== -->
    <section class="md-card">
      <div class="md-card__header">
        <div>
          <h2 class="md-card__title"><%- include('partials/icon', { name: 'receipt', size: 18 }) %> Abrechnung</h2>
          <p class="md-card__support">
            Vorgaben für alle Abrechnungen. Arbeitgeber, Kennzeichen und Fahrer stehen
            nicht hier, sondern am jeweiligen Fahrzeug im <a href="/fuhrpark">Fuhrpark</a> –
            eine einzelne globale Angabe war genau die Beschränkung, die er aufhebt.
          </p>
          <p class="md-card__support">Fließt direkt in PDF, CSV und die Dashboard-Vorschau ein.</p>
        </div>
      </div>

      <div class="md-grid md-cols-3" style="margin-top:20px">
        <label class="md-field">
          <input class="md-field__input md-numeric" type="number" id="billing-pricePerKwh"
                 step="0.0001" min="0" max="10" required placeholder=" "
                 value="<%= settings.billing.pricePerKwh %>">
          <span class="md-field__label">Strompreis (pro kWh)</span>
        </label>
        <label class="md-field">
          <input class="md-field__input" type="text" id="billing-currency" maxlength="3" placeholder=" "
                 value="<%= settings.billing.currency %>" style="text-transform:uppercase">
          <span class="md-field__label">Währung</span>
        </label>
        <label class="md-field">
          <input class="md-field__input" type="text" id="billing-timezone" placeholder=" "
                 value="<%= settings.billing.timezone %>">
          <span class="md-field__label">Zeitzone</span>
        </label>
      </div>

      <label class="md-field" style="margin-top:20px">
        <input class="md-field__input" type="text" id="billing-logoUrl" placeholder=" "
               value="<%= settings.billing.logoUrl %>">
        <span class="md-field__label">Logo-URL (optional)</span>
        <span class="md-field__hint">
          Wird im Kopf des PDFs angezeigt. Ohne Angabe erscheint ein dezenter Platzhalter.
        </span>
      </label>
    </section>

    <!-- ===================== Druckränder ===================== -->
    <section class="md-card">
      <div class="md-card__header">
        <div>
          <h2 class="md-card__title">
            <%- include('partials/icon', { name: 'receipt', size: 18 }) %> Seitenränder des PDF
          </h2>
          <p class="md-card__support">
            Angaben in Millimetern. Voreinstellung nach DIN 5008 mit breitem Heftrand links
            (25 mm) – damit bleibt beim Abheften nichts abgeschnitten.
          </p>
        </div>
      </div>

      <div class="md-grid md-cols-4" style="margin-top:20px">
        <label class="md-field">
          <input class="md-field__input md-numeric" type="number" id="margin-top"
                 min="5" max="60" step="1" placeholder=" " value="<%= settings.billing.margins.top %>">
          <span class="md-field__label">Oben (mm)</span>
        </label>
        <label class="md-field">
          <input class="md-field__input md-numeric" type="number" id="margin-right"
                 min="5" max="60" step="1" placeholder=" " value="<%= settings.billing.margins.right %>">
          <span class="md-field__label">Rechts (mm)</span>
        </label>
        <label class="md-field">
          <input class="md-field__input md-numeric" type="number" id="margin-bottom"
                 min="5" max="60" step="1" placeholder=" " value="<%= settings.billing.margins.bottom %>">
          <span class="md-field__label">Unten (mm)</span>
        </label>
        <label class="md-field">
          <input class="md-field__input md-numeric" type="number" id="margin-left"
                 min="5" max="60" step="1" placeholder=" " value="<%= settings.billing.margins.left %>">
          <span class="md-field__label">Links / Heftrand (mm)</span>
        </label>
      </div>

      <div class="md-banner md-banner--info" style="margin-top:16px">
        <%- include('partials/icon', { name: 'info' }) %>
        <span class="md-body-s">
          Übliche Drucker können die äußersten ca. 5 mm nicht bedrucken. Werte unter 10 mm
          werden deshalb nicht empfohlen; das Minimum liegt bei 5 mm.
        </span>
      </div>
    </section>

    <!-- ===================== E-Mail ===================== -->
    <section class="md-card">
      <div class="md-card__header">
        <div>
          <h2 class="md-card__title"><%- include('partials/icon', { name: 'mail', size: 18 }) %> E-Mail-Versand</h2>
          <p class="md-card__support">
            SMTP-Server: <span class="md-mono"><%= envInfo.smtpHost %>:<%= envInfo.smtpPort %></span>
            <%= envInfo.smtpAuth ? '(authentifiziert)' : '(ohne Authentifizierung)' %> – konfiguriert über die ENV.
          </p>
        </div>
      </div>

      <div class="md-grid md-cols-2" style="margin-top:20px">
        <label class="md-field">
          <input class="md-field__input" type="email" id="mail-from" placeholder=" "
                 value="<%= settings.mail.from %>">
          <span class="md-field__label">Absender</span>
        </label>
        <label class="md-field">
          <input class="md-field__input" type="text" id="mail-subjectPrefix" placeholder=" "
                 value="<%= settings.mail.subjectPrefix %>">
          <span class="md-field__label">Betreff-Präfix</span>
        </label>
        <label class="md-field">
          <textarea class="md-field__textarea" id="mail-to" rows="2" placeholder=" "><%= settings.mail.to.join(', ') %></textarea>
          <span class="md-field__label">Empfänger</span>
          <span class="md-field__hint">Mehrere Adressen mit Komma trennen.</span>
        </label>
        <label class="md-field">
          <textarea class="md-field__textarea" id="mail-cc" rows="2" placeholder=" "><%= settings.mail.cc.join(', ') %></textarea>
          <span class="md-field__label">Kopie (CC)</span>
        </label>
      </div>
    </section>

    <!-- ===================== Automatisierung ===================== -->
    <section class="md-card">
      <div class="md-card__header">
        <div>
          <h2 class="md-card__title"><%- include('partials/icon', { name: 'schedule', size: 18 }) %> Automatisierung</h2>
          <p class="md-card__support">
            Cron-Zeitplan: <span class="md-mono"><%= envInfo.cronExpression %></span>
            (via ENV, <%= envInfo.cronEnabled ? 'aktiv' : 'deaktiviert' %>)
          </p>
        </div>
      </div>

      <div class="md-grid md-cols-2" style="margin-top:20px;align-items:center">
        <label class="md-switch">
          <input type="checkbox" id="scheduler-enabled" <%= settings.scheduler.enabled ? 'checked' : '' %>>
          <span class="md-switch__track"><span class="md-switch__thumb"></span></span>
          <span class="md-body-m">Automatischen Monatsversand aktivieren</span>
        </label>

        <label class="md-field">
          <select id="scheduler-runPolicy" class="md-field__select">
            <option value="last-day-of-month" <%= settings.scheduler.runPolicy === 'last-day-of-month' ? 'selected' : '' %>>Nur am Monatsletzten</option>
            <option value="always" <%= settings.scheduler.runPolicy === 'always' ? 'selected' : '' %>>Bei jedem Cron-Lauf (Test)</option>
          </select>
          <span class="md-field__label">Ausführung</span>
          <span class="md-field__arrow"><%- include('partials/icon', { name: 'expand', size: 18 }) %></span>
        </label>
      </div>

      <p class="md-body-s md-on-surface-variant" style="margin-top:16px">
        Änderungen an Zeitplan und Aktivierung greifen nach einem Neustart des Containers.
      </p>
    </section>

    <div class="md-row">
      <button type="submit" id="save-button" class="md-btn md-btn--filled">
        <%- include('partials/icon', { name: 'check', size: 18 }) %> Einstellungen speichern
      </button>
      <span id="save-hint" class="md-body-s md-on-surface-variant"></span>
    </div>
  </form>

  <!-- ===================== Manueller Lauf ===================== -->
  <section class="md-card" style="margin-top:24px">
    <div class="md-card__header">
      <div>
        <h2 class="md-card__title"><%- include('partials/icon', { name: 'receipt', size: 18 }) %> Abrechnung manuell erzeugen</h2>
        <p class="md-card__support">Erzeugt PDF und CSV für den gewählten Monat – optional mit sofortigem Versand.</p>
      </div>
    </div>

    <div class="md-row" style="margin-top:20px;align-items:flex-end">
      <label class="md-field" style="width:180px">
        <select id="run-month" class="md-field__select">
          <% months.forEach(function (month) { %>
            <option value="<%= month.value %>" <%= month.value === defaultMonth ? 'selected' : '' %>><%= month.name %></option>
          <% }); %>
        </select>
        <span class="md-field__label">Monat</span>
        <span class="md-field__arrow"><%- include('partials/icon', { name: 'expand', size: 18 }) %></span>
      </label>

      <label class="md-field" style="width:130px">
        <select id="run-year" class="md-field__select">
          <% years.forEach(function (year) { %>
            <option value="<%= year %>" <%= year === defaultYear ? 'selected' : '' %>><%= year %></option>
          <% }); %>
        </select>
        <span class="md-field__label">Jahr</span>
        <span class="md-field__arrow"><%- include('partials/icon', { name: 'expand', size: 18 }) %></span>
      </label>

      <label class="md-switch" style="padding-bottom:12px">
        <input type="checkbox" id="run-sendmail">
        <span class="md-switch__track"><span class="md-switch__thumb"></span></span>
        <span class="md-body-m">E-Mail versenden</span>
      </label>

      <button type="button" id="run-button" class="md-btn md-btn--tonal" style="margin-bottom:12px">
        Jetzt erzeugen
      </button>
    </div>

    <div id="run-result" class="hidden" style="margin-top:16px"></div>
  </section>

  <!-- ===================== Läufe & Dateien ===================== -->
  <section class="md-grid md-cols-2" style="margin-top:24px">

    <div class="md-card">
      <h2 class="md-card__title"><%- include('partials/icon', { name: 'history', size: 18 }) %> Letzte Läufe</h2>
      <% if (runs.length === 0) { %>
        <p class="md-body-m md-on-surface-variant" style="margin-top:16px">Noch kein Lauf protokolliert.</p>
      <% } else { %>
        <ul class="md-list" style="margin-top:12px">
          <% runs.forEach(function (run) { %>
            <li class="md-list__item">
              <span class="md-dot" style="color:<%= run.ok ? 'var(--md-primary)' : 'var(--md-error)' %>"></span>
              <span class="md-list__text">
                <span class="md-list__headline"><%= run.periodKey %> &middot; <%= run.triggeredBy %></span>
                <span class="md-list__support">
                  <%= new Date(run.startedAt).toLocaleString(settings.billing.locale) %>
                  <% if (run.ok) { %>
                    &middot; <%= run.energyKwh %> kWh<%= run.mailTo ? ' → ' + run.mailTo : '' %>
                  <% } else { %>
                    &middot; <%= run.error %>
                  <% } %>
                </span>
              </span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <div class="md-card">
      <h2 class="md-card__title"><%- include('partials/icon', { name: 'download', size: 18 }) %> Erzeugte Dateien</h2>
      <p class="md-card__support">Ablage: <span class="md-mono"><%= envInfo.outputDir %></span></p>

      <% if (files.length === 0) { %>
        <p class="md-body-m md-on-surface-variant" style="margin-top:16px">Noch keine Dateien erzeugt.</p>
      <% } else { %>
        <ul class="md-list" style="margin-top:12px">
          <% files.forEach(function (file) { %>
            <li class="md-list__item">
              <span class="md-list__text">
                <a class="md-list__headline" href="/api/report/files/<%= encodeURIComponent(file.fileName) %>"><%= file.fileName %></a>
                <span class="md-list__support"><%= new Date(file.modifiedAt).toLocaleString(settings.billing.locale) %></span>
              </span>
              <span class="md-body-s md-on-surface-variant md-numeric"><%= Math.round(file.sizeBytes / 1024) %> KB</span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </section>

</main>

<script src="/static/js/settings.js?v=<%= assetVersion %>" nonce="<%= cspNonce %>" defer></script>

<%- include('partials/foot') %>
