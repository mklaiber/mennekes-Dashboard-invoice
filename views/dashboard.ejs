<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="md-content">

  <div class="md-row" style="margin-bottom:24px">
    <div>
      <h1 class="md-headline-m" style="margin:0">Live-Übersicht</h1>
      <p class="md-body-m md-on-surface-variant" style="margin:4px 0 0">
        Echtzeitdaten der Wallbox, aktualisiert alle <%= Math.round(pollIntervalMs / 1000) %> Sekunden.
      </p>
    </div>
    <span class="md-spacer"></span>
    <span id="connection" class="md-chip">
      <span id="connection-dot" class="md-dot" style="color:var(--md-outline)"></span>
      <span id="connection-text">Verbinde …</span>
    </span>
  </div>

  <% if (connector) { %>
    <div class="md-banner <%= connector.connected ? 'md-banner--info' : 'md-banner--warning' %>"
         style="margin-bottom:24px" id="connector-banner">
      <%- include('partials/icon', { name: connector.connected ? 'shield' : 'warning' }) %>
      <span>
        <% if (connector.connected) { %>
          <strong>Connector verbunden.</strong>
          Die Wallbox wird über das Home-Assistant-Add-on im Heimnetz gelesen –
          zuletzt vor <%= connector.secondsSinceLastSeen %> Sekunden.
          <% if (connector.version) { %>(Version <%= connector.version %>)<% } %>
        <% } else if (!connector.lastSeenAt) { %>
          <strong>Der Connector hat sich noch nie gemeldet.</strong>
          Bis dahin bleiben Live-Anzeige und Abrechnung leer. Bitte im
          Home-Assistant-Add-on <span class="md-mono">target_url</span> und
          <span class="md-mono">target_token</span> prüfen.
        <% } else { %>
          <strong>Der Connector meldet sich seit
          <%= Math.round(connector.secondsSinceLastSeen / 60) %> Minuten nicht mehr.</strong>
          Die angezeigten Werte sind nicht aktuell. Läuft das Add-on in Home Assistant noch?
        <% } %>
      </span>
    </div>
  <% } %>

  <div id="error-banner" class="md-banner md-banner--error hidden" role="alert" style="margin-bottom:24px">
    <%- include('partials/icon', { name: 'warning' }) %>
    <span><strong>Wallbox nicht erreichbar:</strong> <span id="error-message"></span></span>
  </div>

  <!-- ===================== Live-Kacheln ===================== -->
  <section class="md-grid md-cols-2-1" style="margin-bottom:24px">

    <div class="md-card md-card--elevated">
      <div class="md-card__header">
        <div>
          <div class="md-metric__label">Aktuelle Ladeleistung</div>
          <div style="display:flex;align-items:baseline;gap:6px;margin-top:8px">
            <span id="power-value" class="md-numeric" style="font-size:56px;line-height:1;font-weight:400">–</span>
            <span class="md-title-l md-on-surface-variant">kW</span>
          </div>
          <p id="power-detail" class="md-body-m md-on-surface-variant" style="margin:10px 0 0">
            Warte auf Daten …
          </p>
        </div>

        <div style="text-align:right">
          <span id="status-pill" class="md-chip">
            <span id="status-dot" class="md-dot" style="color:var(--md-outline)"></span>
            <span id="status-label">Unbekannt</span>
          </span>
          <p id="status-updated" class="md-body-s md-on-surface-variant" style="margin:8px 0 0">–</p>
        </div>
      </div>

      <!-- Leistungsverlauf der laufenden Sitzung (rein clientseitig gepuffert) -->
      <div style="margin-top:24px">
        <div class="md-row" style="justify-content:space-between;gap:8px">
          <span class="md-body-s md-on-surface-variant">
            Verlauf (letzte <span id="spark-window">0</span> Messwerte)
          </span>
          <span class="md-body-s md-on-surface-variant">
            Max <span id="spark-max" class="md-numeric">0,0</span> kW
          </span>
        </div>

        <div style="position:relative;margin-top:8px">
          <svg id="sparkline" viewBox="0 0 600 100" preserveAspectRatio="none" role="img"
               aria-label="Verlauf der Ladeleistung" style="width:100%;height:110px;display:block">
            <defs>
              <linearGradient id="sparkFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="var(--md-primary)" stop-opacity=".30"/>
                <stop offset="100%" stop-color="var(--md-primary)" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <!-- Grundlinie: die Fläche wirkt sonst kaputt, solange keine Messwerte da sind. -->
            <line x1="0" y1="97" x2="600" y2="97" stroke="var(--md-outline-variant)"
                  stroke-width="1" vector-effect="non-scaling-stroke"/>
            <path id="spark-area" fill="url(#sparkFill)" d=""></path>
            <path id="spark-line" fill="none" stroke="var(--md-primary)" stroke-width="2"
                  stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" d=""></path>
          </svg>
          <p id="spark-hint" class="md-body-s md-on-surface-variant"
             style="position:absolute;inset:0;display:grid;place-items:center;margin:0">
            Sammelt Messwerte …
          </p>
        </div>
      </div>
    </div>

    <div class="md-card">
      <div class="md-metric__label">Aktive Ladekarte</div>
      <p id="rfid-name" class="md-headline-s" style="margin:12px 0 2px">–</p>
      <p id="rfid-id" class="md-mono md-on-surface-variant" style="margin:0">keine Karte erkannt</p>

      <hr class="md-divider" style="margin:20px 0">

      <dl class="md-list" style="margin:0">
        <div class="md-list__item" style="padding:10px 0">
          <dt class="md-body-m md-on-surface-variant md-spacer">Energie (Sitzung)</dt>
          <dd id="session-energy" class="md-label-l md-numeric" style="margin:0">–</dd>
        </div>
        <div class="md-list__item" style="padding:10px 0">
          <dt class="md-body-m md-on-surface-variant md-spacer">Ladedauer</dt>
          <dd id="session-duration" class="md-label-l md-numeric" style="margin:0">–</dd>
        </div>
        <div class="md-list__item" style="padding:10px 0">
          <dt class="md-body-m md-on-surface-variant md-spacer">Strom</dt>
          <dd id="current" class="md-label-l md-numeric" style="margin:0">–</dd>
        </div>
        <div class="md-list__item" style="padding:10px 0">
          <dt class="md-body-m md-on-surface-variant md-spacer">Spannung</dt>
          <dd id="voltage" class="md-label-l md-numeric" style="margin:0">–</dd>
        </div>
        <div class="md-list__item" style="padding:10px 0">
          <dt class="md-body-m md-on-surface-variant md-spacer">Zählerstand</dt>
          <dd id="meter" class="md-label-l md-numeric" style="margin:0">–</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ===================== Abrechnungsvorschau ===================== -->
  <section>
    <div class="md-row" style="margin-bottom:16px">
      <div>
        <h2 class="md-title-l" style="margin:0">Abrechnungsvorschau</h2>
        <p class="md-body-m md-on-surface-variant" style="margin:4px 0 0">
          Aus der Ladehistorie berechnet – Grundlage für PDF und CSV.
        </p>
      </div>
      <span class="md-spacer"></span>
      <label class="md-field" style="width:200px">
        <select id="period" class="md-field__select"></select>
        <span class="md-field__label">Abrechnungsmonat</span>
        <span class="md-field__arrow"><%- include('partials/icon', { name: 'expand', size: 18 }) %></span>
      </label>
      <button id="reload-report" type="button" class="md-btn md-btn--tonal">
        <%- include('partials/icon', { name: 'refresh', size: 18 }) %> Aktualisieren
      </button>
    </div>

    <div id="report-loading" class="md-card">
      <div class="md-progress"><div class="md-progress__bar"></div></div>
      <p class="md-body-m md-on-surface-variant" style="margin:16px 0 0;text-align:center">
        Lade Abrechnungsdaten …
      </p>
    </div>

    <div id="report-content" class="hidden">
      <div class="md-grid md-cols-4" style="margin-bottom:16px">
        <div class="md-card">
          <div class="md-metric__label">Energie gesamt</div>
          <div class="md-metric__value"><span id="kpi-energy">–</span><span class="md-metric__unit">kWh</span></div>
        </div>
        <div class="md-card">
          <div class="md-metric__label">Ladevorgänge</div>
          <div class="md-metric__value" id="kpi-sessions">–</div>
        </div>
        <div class="md-card">
          <div class="md-metric__label">Ladezeit</div>
          <div class="md-metric__value" id="kpi-duration">–</div>
        </div>
        <div class="md-card md-card--primary">
          <div class="md-metric__label">Erstattungsbetrag</div>
          <div class="md-metric__value" id="kpi-cost">–</div>
        </div>
      </div>

      <div class="md-card md-card--flush">
        <div class="md-table-wrap">
          <table class="md-table">
            <caption class="sr-only">Verbrauch je Ladekarte im gewählten Abrechnungsmonat</caption>
            <thead>
              <tr>
                <th scope="col">Ladekarte</th>
                <th scope="col">RFID</th>
                <th scope="col" class="md-num">Vorgänge</th>
                <th scope="col" class="md-num">Ladezeit</th>
                <th scope="col" class="md-num">Energie</th>
                <th scope="col" class="md-num">Betrag</th>
              </tr>
            </thead>
            <tbody id="report-rows"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Letzte Abrechnungsläufe ===================== -->
  <% if (runs && runs.length > 0) { %>
  <section style="margin-top:32px">
    <h2 class="md-title-l" style="margin:0 0 4px">
      <%- include('partials/icon', { name: 'history', size: 20 }) %> Letzte Abrechnungsläufe
    </h2>
    <p class="md-body-m md-on-surface-variant" style="margin:0 0 16px">
      Automatische und manuell ausgelöste Läufe mit Ergebnis.
    </p>

    <div class="md-card md-card--flush">
      <div class="md-table-wrap">
        <table class="md-table">
          <thead>
            <tr>
              <th scope="col">Zeitraum</th>
              <th scope="col">Gestartet</th>
              <th scope="col">Auslöser</th>
              <th scope="col" class="md-num">Energie</th>
              <th scope="col">Versand</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            <% runs.forEach(function (run) { %>
              <tr>
                <td><span class="md-label-l"><%= run.periodKey %></span></td>
                <td class="md-body-s md-on-surface-variant">
                  <%= new Date(run.startedAt).toLocaleString(settings.billing.locale) %>
                </td>
                <td class="md-body-s md-on-surface-variant"><%= run.triggeredBy %></td>
                <td class="md-num"><%= run.energyKwh === null ? '–' : run.energyKwh + ' kWh' %></td>
                <td class="md-body-s md-on-surface-variant"><%= run.mailTo || '–' %></td>
                <td>
                  <% if (run.ok) { %>
                    <span class="md-chip md-chip--primary md-chip--small">
                      <%- include('partials/icon', { name: 'check', size: 14 }) %> erfolgreich
                    </span>
                  <% } else { %>
                    <span class="md-chip md-chip--error md-chip--small" title="<%= run.error %>">
                      <%- include('partials/icon', { name: 'error', size: 14 }) %> fehlgeschlagen
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <% } %>

</main>

<footer class="md-content" style="padding-top:0;padding-bottom:32px">
  <p class="md-body-s md-on-surface-variant" style="margin:0">
    Mennekes Wallbox Billing &middot; Zeitzone <%= settings.billing.timezone %> &middot;
    Arbeitspreis <%= settings.billing.pricePerKwh.toFixed(4).replace('.', ',') %> <%= settings.billing.currency %>/kWh
  </p>
</footer>

<script id="bootstrap-data" type="application/json" nonce="<%= cspNonce %>">
  <%- JSON.stringify({
        initialState: initialState || null,
        currency: settings.billing.currency,
        locale: settings.billing.locale,
        timezone: settings.billing.timezone,
      }) %>
</script>
<script src="/static/js/dashboard.js?v=<%= assetVersion %>" nonce="<%= cspNonce %>" defer></script>

<%- include('partials/foot') %>
