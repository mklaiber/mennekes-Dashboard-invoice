<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="md-content" style="max-width:720px">

  <div style="margin-bottom:24px">
    <h1 class="md-headline-m" style="margin:0">Passwort ändern</h1>
    <p class="md-body-m md-on-surface-variant" style="margin:4px 0 0">
      Angemeldet als <strong><%= currentUser.username %></strong>
      (<%= currentUser.role === 'admin' ? 'Administrator' : 'Betrachter' %>).
    </p>
  </div>

  <% if (forced) { %>
    <div class="md-banner md-banner--warning" style="margin-bottom:24px" role="alert">
      <%- include('partials/icon', { name: 'warning' }) %>
      <span>
        Für dieses Konto ist ein Passwortwechsel hinterlegt. Bis das neue Passwort
        gesetzt ist, sind die übrigen Bereiche gesperrt.
      </span>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="md-banner md-banner--success" style="margin-bottom:24px" role="status">
      <%- include('partials/icon', { name: 'check' }) %>
      <span>Passwort geändert. Alle anderen Sitzungen wurden beendet.</span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="md-banner md-banner--error" style="margin-bottom:24px" role="alert">
      <%- include('partials/icon', { name: 'error' }) %>
      <span><%= error %></span>
    </div>
  <% } %>

  <section class="md-card">
    <form method="post" action="/passwort" class="md-stack" style="gap:20px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label class="md-field">
        <input class="md-field__input" type="password" name="currentPassword" placeholder=" "
               required autocomplete="current-password">
        <span class="md-field__label">Aktuelles Passwort</span>
      </label>

      <label class="md-field">
        <input class="md-field__input" type="password" name="newPassword" placeholder=" "
               required autocomplete="new-password" minlength="<%= minLength %>">
        <span class="md-field__label">Neues Passwort</span>
        <span class="md-field__hint">
          Mindestens <%= minLength %> Zeichen. Länge zählt mehr als Sonderzeichen –
          eine Passphrase aus mehreren Wörtern ist eine gute Wahl.
        </span>
      </label>

      <label class="md-field">
        <input class="md-field__input" type="password" name="repeatPassword" placeholder=" "
               required autocomplete="new-password" minlength="<%= minLength %>">
        <span class="md-field__label">Neues Passwort wiederholen</span>
      </label>

      <div class="md-row">
        <button type="submit" class="md-btn md-btn--filled">
          <%- include('partials/icon', { name: 'key', size: 18 }) %> Passwort speichern
        </button>
      </div>
    </form>
  </section>

  <!-- ===================== Offene Sitzungen ===================== -->
  <section class="md-card" style="margin-top:24px">
    <h2 class="md-card__title">Offene Sitzungen</h2>
    <p class="md-card__support">
      Geräte, auf denen dieses Konto derzeit angemeldet ist. Ein Passwortwechsel
      beendet alle bis auf die aktuelle.
    </p>

    <ul class="md-list" style="margin-top:12px">
      <% sessions.forEach(function (entry) { %>
        <li class="md-list__item">
          <%- include('partials/icon', { name: 'person' }) %>
          <span class="md-list__text">
            <span class="md-list__headline"><%= entry.userAgent || 'Unbekanntes Gerät' %></span>
            <span class="md-list__support">
              <%= entry.ip || 'ohne IP' %> &middot;
              zuletzt <%= new Date(entry.lastSeenAt).toLocaleString('de-DE') %> &middot;
              gültig bis <%= new Date(entry.expiresAt).toLocaleString('de-DE') %>
            </span>
          </span>
        </li>
      <% }); %>
    </ul>
  </section>

</main>

<%- include('partials/foot') %>
