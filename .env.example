# =============================================================================
#  Mennekes Wallbox Billing - Umgebungskonfiguration
#  Kopieren nach `.env` und ausfüllen. Die .env gehört NICHT ins Git-Repo.
#  Im Ansible-Deployment wird diese Datei aus ansible/templates/env.j2 erzeugt.
# =============================================================================

# ------------------------------- Laufzeit ------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TZ=Europe/Berlin
LOG_LEVEL=info

# Auf `true` setzen, wenn die App hinter nginx/Traefik läuft (echte Client-IP).
TRUST_PROXY=false

# Ablage der erzeugten PDFs/CSVs.
# Im Container Volume-gemountet - siehe docker-compose.yml.
OUTPUT_DIR=/app/data/reports

# SQLite-Datenbank: Benutzerkonten, Sitzungen, Einstellungen, RFID-Zuordnung
# und Protokoll. MUSS auf einem persistenten Volume liegen.
DATABASE_FILE=/app/data/wallbox.sqlite

# Nur noch für die einmalige Übernahme einer alten Dateiversion relevant.
SETTINGS_FILE=/app/data/settings.json

# ------------------------- WebUI-Authentifizierung ---------------------------
# Zugangsdaten des START-Administrators. Sie werden NUR beim allerersten Start
# verwendet, solange die Benutzertabelle leer ist. Danach ist die Datenbank
# führend - weitere Konten legen Sie in der WebUI unter "Benutzer" an, und eine
# Änderung dieser Werte bleibt wirkungslos.
# PFLICHT beim ersten Start. Erzeugen z. B. mit:  openssl rand -base64 24
AUTH_USER=admin
AUTH_PASSWORD=
AUTH_REALM=Mennekes Wallbox Abrechnung

# Mindestlänge für alle Passwörter (Länge zählt mehr als Sonderzeichen).
AUTH_MIN_PASSWORD_LENGTH=12

# Kontosperre nach zu vielen Fehlversuchen.
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCK_MINUTES=15

# Basic-Auth für maschinelle Zugriffe auf /api zulassen (Docker-Healthcheck,
# Skripte, Monitoring). Auf false setzen, wenn ausschließlich Browser-Anmeldung
# erlaubt sein soll - dann schlägt allerdings der Healthcheck fehl.
AUTH_ALLOW_BASIC_API=true

# --------------------------------- Sitzungen ---------------------------------
SESSION_TTL_HOURS=12
# Lebensdauer bei "Angemeldet bleiben".
SESSION_REMEMBER_DAYS=30
SESSION_COOKIE_NAME=wb_session
# Secure-Flag: nur über HTTPS ausliefern. Im LAN ohne TLS auf false setzen,
# sonst erreicht das Cookie den Browser nie und die Anmeldung schlägt fehl.
SESSION_COOKIE_SECURE=true

# ------------------------------- Datenquelle ---------------------------------
# direct    - diese Anwendung läuft im selben Netz wie die Wallbox und fragt
#             sie selbst ab (Standard).
# connector - die Wallbox steht im Heimnetz und ist von hier NICHT erreichbar.
#             Ein Home-Assistant-Add-on (siehe mennekes-connector/) liest sie
#             dort aus und schiebt die Daten hierher. Die Verbindung geht immer
#             vom Heimnetz nach außen - keine Portweiterleitung nötig.
DATA_SOURCE=direct

# Gemeinsames Geheimnis mit dem Connector. PFLICHT bei DATA_SOURCE=connector.
# Erzeugen mit:  openssl rand -hex 32
CONNECTOR_TOKEN=

# Ab wann gilt der Connector als abgemeldet? Das Dashboard weist dann darauf
# hin, dass die Werte nicht mehr aktuell sind.
CONNECTOR_STALE_SECONDS=120

# Obergrenze je Sendung des Connectors.
CONNECTOR_MAX_BATCH=500

# ----------------------------- Mennekes Wallbox ------------------------------
# Nur bei DATA_SOURCE=direct erforderlich. Im Connector-Betrieb wird die
# Wallbox von hier aus nie angesprochen; ihre Adresse steht dann in den
# Optionen des Home-Assistant-Add-ons.
MENNEKES_BASE_URL=http://192.168.1.50

# Auth-Verfahren der Wallbox-API: none | basic | bearer | apikey
MENNEKES_AUTH_MODE=none
MENNEKES_USERNAME=
MENNEKES_PASSWORD=
MENNEKES_TOKEN=
MENNEKES_API_KEY_HEADER=X-API-Key

MENNEKES_TIMEOUT_MS=8000
MENNEKES_RETRIES=2
# Nur auf false setzen, wenn die Wallbox ein selbstsigniertes TLS-Zertifikat nutzt.
MENNEKES_TLS_REJECT_UNAUTHORIZED=true

# --- Endpunkt-Pfade -----------------------------------------------------------
# Die Pfade unterscheiden sich je nach Firmware-Generation. Vor dem ersten
# Produktivlauf gegen die eigene Wallbox prüfen, z. B. mit:
#   curl -s http://<WALLBOX-IP>/api/v1/status | jq
# Der Client ist tolerant gegenüber der Feldbenennung - nur die PFADE müssen stimmen.
MENNEKES_ENDPOINT_STATUS=/api/v1/status
MENNEKES_ENDPOINT_SESSIONS=/api/v1/transactions
# Optional: separater Endpunkt für Zähler-/Leistungswerte. Leer lassen, wenn
# der Status-Endpunkt diese Werte bereits mitliefert.
MENNEKES_ENDPOINT_METER=

# Query-Parameternamen für die Zeitraumfilterung der Historie.
MENNEKES_SESSIONS_FROM_PARAM=from
MENNEKES_SESSIONS_TO_PARAM=to
MENNEKES_SESSIONS_LIMIT_PARAM=limit
MENNEKES_SESSIONS_LIMIT=1000

# ---------------------------------- SMTP -------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = implizites TLS (Port 465), false = STARTTLS (Port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --------------------------------- E-Mail ------------------------------------
MAIL_FROM=wallbox@example.com
# Mehrere Empfänger mit Komma trennen. Nachträglich in der WebUI pflegbar.
MAIL_TO=buchhaltung@arbeitgeber.de
MAIL_CC=
MAIL_SUBJECT_PREFIX=Ladestrom-Abrechnung

# -------------------------------- Abrechnung ---------------------------------
# Startwerte für die WebUI-Einstellungen (danach ist settings.json führend).
PRICE_PER_KWH=0.30
CURRENCY=EUR
LOCALE=de-DE
COMPANY_NAME=
EMPLOYEE_NAME=
VEHICLE_PLATE=
# Logo im PDF-Kopf: absolute URL oder data:-URI.
LOGO_URL=

# ------------------------------ Automatisierung ------------------------------
CRON_ENABLED=true
# Täglich 23:30 Uhr. Der Job prüft selbst, ob heute der Monatsletzte ist
# (node-cron kennt kein "L" für den letzten Tag des Monats).
CRON_EXPRESSION=30 23 * * *
# last-day-of-month | always  ("always" nur zum Testen)
CRON_RUN_POLICY=last-day-of-month

# ------------------------------- Live-Dashboard ------------------------------
LIVE_POLL_INTERVAL_MS=5000
LIVE_HEARTBEAT_MS=25000

# --------------------------------- Puppeteer ---------------------------------
# Im Container wird das System-Chromium genutzt (siehe Dockerfile).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_NO_SANDBOX=true
